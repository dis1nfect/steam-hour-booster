{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Hour Booster",
  "version": "1.0.1",
  "identifier": "app.steamhourbooster.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Steam Hour Booster",
        "width": 460,
        "height": 780,
        "minWidth": 400,
        "minHeight": 600,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0a0b14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: https://cdn.cloudflare.steamstatic.com https://shared.cloudflare.steamstatic.com; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../booster.js": "booster/booster.js",
      "../../node_modules/": "booster/node_modules/"
    }
  }
}
